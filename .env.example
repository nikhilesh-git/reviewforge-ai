# =============================================================================
# GitHub PR Code Reviewer — Environment Variables (Cloud Ready)
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=github-pr-reviewer
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# GitHub Integration
# -----------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=change-me-to-a-strong-random-secret
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app_private_key
GITHUB_PAT=

# -----------------------------------------------------------------------------
# PostgreSQL (Neon.tech / Supabase)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@hostname.neon.tech/dbname?sslmode=require"

# -----------------------------------------------------------------------------
# Redis (Upstash)
# -----------------------------------------------------------------------------
REDIS_URL="rediss://default:password@endpoint.upstash.io:6379?ssl_cert_reqs=CERT_NONE"
CELERY_BROKER_URL="rediss://default:password@endpoint.upstash.io:6379/1?ssl_cert_reqs=CERT_NONE"
CELERY_RESULT_BACKEND="rediss://default:password@endpoint.upstash.io:6379/2?ssl_cert_reqs=CERT_NONE"

REDIS_STREAM_NAME=pr:events
REDIS_STREAM_CONSUMER_GROUP=review-workers
REDIS_MAX_STREAM_LENGTH=10000

# -----------------------------------------------------------------------------
# OpenRouter (LLM provider — free tier)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

PRIMARY_MODEL=qwen/qwen3-coder:free
FALLBACK_MODEL=deepseek/deepseek-v3-base:free

LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT=120

# -----------------------------------------------------------------------------
# Qdrant (Vector database for repo memory)
# -----------------------------------------------------------------------------
QDRANT_URL="https://your-cluster.cloud.qdrant.io"
QDRANT_API_KEY="your-qdrant-api-key"

# -----------------------------------------------------------------------------
# Langfuse (LLM observability - Cloud)
# -----------------------------------------------------------------------------
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# -----------------------------------------------------------------------------
# Security / Auth
# -----------------------------------------------------------------------------
INTERNAL_API_KEY=change-me-internal-api-key-min-32-chars
MAX_WEBHOOK_EVENTS_PER_MINUTE=100
MAX_REVIEW_JOBS_PER_REPO_PER_HOUR=20
