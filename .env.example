# =============================================================================
# GitHub PR Code Reviewer — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=github-pr-reviewer
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# GitHub Integration
# -----------------------------------------------------------------------------
# HMAC secret configured in your GitHub App / Webhook settings
GITHUB_WEBHOOK_SECRET=change-me-to-a-strong-random-secret

# GitHub App credentials (preferred over PAT for production)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app_private_key

# Personal Access Token (fallback for development — at least repo + pr scope)
GITHUB_PAT=

# -----------------------------------------------------------------------------
# PostgreSQL (application database)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=prreviewer
POSTGRES_PASSWORD=prreviewer_strongpass_changeme
POSTGRES_DB=prreviewer

# Async DSN (auto-constructed by services — override only if needed)
# DATABASE_URL=postgresql+asyncpg://prreviewer:prreviewer_strongpass_changeme@postgres:5432/prreviewer

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_STREAM_NAME=pr:events
REDIS_STREAM_CONSUMER_GROUP=review-workers
REDIS_MAX_STREAM_LENGTH=10000

# Celery broker / backend
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -----------------------------------------------------------------------------
# OpenRouter (LLM provider — free tier)
# Get your key at https://openrouter.ai — no credit card needed for free models
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Primary model (free tier)
PRIMARY_MODEL=qwen/qwen3-coder:free
# Fallback model (free tier)
FALLBACK_MODEL=deepseek/deepseek-v3-base:free
# Gemini alternative (set GOOGLE_API_KEY if using Gemini directly)
# PRIMARY_MODEL=google/gemini-2.5-flash
# GOOGLE_API_KEY=

# LLM request settings
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT=120

# -----------------------------------------------------------------------------
# Qdrant (Vector database for repo memory)
# -----------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=repo_conventions
QDRANT_EMBEDDING_DIM=384

# -----------------------------------------------------------------------------
# Langfuse (Self-hosted LLM observability)
# -----------------------------------------------------------------------------
LANGFUSE_SECRET_KEY=lf-sk-change-me-in-production
LANGFUSE_PUBLIC_KEY=lf-pk-change-me-in-production
LANGFUSE_HOST=http://langfuse-server:3000

# Langfuse self-hosted DB secrets
LANGFUSE_DATABASE_URL=postgresql://langfuse_user:langfuse_pass@langfuse-postgres:5432/langfuse
LANGFUSE_NEXTAUTH_SECRET=change-me-nextauth-secret-min-32-chars
LANGFUSE_SALT=change-me-salt-min-32-chars
LANGFUSE_TELEMETRY_ENABLED=false

# -----------------------------------------------------------------------------
# Prometheus / Grafana
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_changeme

# -----------------------------------------------------------------------------
# Security / Auth
# -----------------------------------------------------------------------------
# API key for internal service-to-service calls
INTERNAL_API_KEY=change-me-internal-api-key-min-32-chars

# JWT settings (for future dashboard auth)
JWT_SECRET_KEY=change-me-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
MAX_WEBHOOK_EVENTS_PER_MINUTE=100
MAX_REVIEW_JOBS_PER_REPO_PER_HOUR=20
